{
    "name": "paytabs/php-sdk",
    "description": "Official PayTabs PHP SDK for Payment Gateway integrations",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "paytabs",
        "payment",
        "gateway",
        "sdk",
        "php"
    ],
    "support": {
        "issues": "https://github.com/paytabscom/php-sdk/issues",
        "source": "https://github.com/paytabscom/php-sdk"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "netresearch/jsonmapper": "^5.0",
        "psr/log": "^3.0"
    },
    "_comment": "Runtime floor is PHP 8.1 so the SDK can ship inside e-commerce plugins on older merchant hosting. The dev toolchain below needs 8.2+ (PHPUnit 11 dropped 8.1), so contributing requires 8.2 even though consuming does not.",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Paytabs\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Paytabs\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "format": "vendor/bin/php-cs-fixer fix"
    }
}
